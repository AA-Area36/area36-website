    "deploy": "opennextjs-cloudflare build && pnpm db:migrate:remote && wrangler deploy",
    "deploy:uptime": "wrangler deploy -c workers/uptime/wrangler.jsonc",
    "deploy:monthly-report": "wrangler deploy -c workers/monthly-report/wrangler.jsonc"
