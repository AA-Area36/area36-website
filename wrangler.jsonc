{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "area36-website",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "GDRIVE_ROOT_FOLDER_ID": "",
    "GDRIVE_NEWSLETTERS_FOLDER_ID": "1ux5PcUF8KkROir3GrL_4F6POPz81_rQN",
    "GDRIVE_RESOURCES_FOLDER_ID": "1SxpurNxZUh5tObUo2JxqMSHYMjDqdoyb",
    "GDRIVE_RECORDINGS_FOLDER_ID": "1Br1EC8YmVz5yX4UsmTkTlKXUSKCufakD",
    "GDRIVE_COMMITTEES_FOLDER_ID": "1gtwNjoFO3phENdJ-aCXq0ps7sTDDen0U",
    "GDRIVE_SERVICE_RESOURCES_FOLDER_ID": "1O9ec6xM1Z_XXlU3C53-eX6XBDKWA82Nx",
    "GDRIVE_QUORUM_FOLDER_ID": "17c_fxGI1xGi4vkOTVAmsDe0k1irGrLMi",
    "QUORUM_DRIVE_OWNER_EMAIL": "webmaster@area36.org",
    "GMAIL_SENDER_EMAIL": "webmaster@area36.org",
    "PUBLIC_HTML_CACHE_ENABLED": "1",
    "PUBLIC_HTML_CACHE_HOSTS": "area36.org,www.area36.org"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "area36-website",
      "database_id": "646074b4-8660-4ab4-98aa-54511636bc0e",
      "migrations_dir": "lib/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DRIVE_IMAGES",
      "bucket_name": "area36-drive-confirmations"
    },
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "area36-reports"
    }
  ]
}
